// Virtual Lab data model. Experiments are stored as structured JSON documents so new
// component types and simulation features never require a schema migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  name        String?
  email       String?      @unique
  studentId   String?
  institution String?
  createdAt   DateTime     @default(now())
  experiments Experiment[]
}

model Experiment {
  id             String   @id
  title          String
  category       String // "chemistry" | "physics"
  status         String   @default("draft") // draft | completed
  workspaceState Json // viewport, grid, lab mode
  components     Json // LabComponent[]
  wires          Json // Wire[]
  chemicals      Json // chemical inventory used
  measurements   Json // Measurement[]
  dataRows       Json // DataRow[]
  timeline       Json // TimelineEvent[]
  observations   Json // string[]
  charts         Json // ChartConfig[]
  notebook       Json // NotebookSections
  report         Json // ReportMeta
  recording      Json? // RecordedFrame[]
  thumbnail      String? @db.Text
  ownerId        String?
  owner          User?    @relation(fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
  @@index([category])
}
